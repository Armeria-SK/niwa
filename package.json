{
  "name": "niwa",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "start": "node dist/entrypoints/server.js",
    "restore": "node dist/entrypoints/restore.js",
    "workspace": "node dist/entrypoints/workspace.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.mjs && node scripts/copy-licenses.mjs",
    "test": "tsc -p tsconfig.test.json && node --test .local/test-build/tests/*.test.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@sinclair/typebox": "0.34.41",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
