[Unit]
Description=Niwa private workspace service
Before=niwa.service
RequiresMountsFor=/home/niwa/niwa/workspace /home/niwa/niwa/runtime/executor/state

[Service]
Type=exec
User=niwa-exec
Group=niwa-exec
SupplementaryGroups=niwa-ipc
WorkingDirectory=/home/niwa/niwa
ExecStart=/usr/bin/node /home/niwa/niwa/dist/entrypoints/workspace.js --workspace /home/niwa/niwa/workspace --socket /home/niwa/niwa/runtime/sockets/workspace.sock --state /home/niwa/niwa/runtime/executor/state
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/niwa/niwa/workspace /home/niwa/niwa/runtime/sockets /home/niwa/niwa/runtime/executor/state
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
