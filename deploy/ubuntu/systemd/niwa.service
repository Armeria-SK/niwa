[Unit]
Description=Niwa application
Wants=network-online.target
After=network-online.target niwa-workspace.service
RequiresMountsFor=/home/niwa/niwa

[Service]
Type=exec
User=niwa
Group=niwa
SupplementaryGroups=niwa-ipc
WorkingDirectory=/home/niwa/niwa
ExecStart=/usr/bin/node /home/niwa/niwa/dist/entrypoints/server.js --root /home/niwa/niwa
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/niwa/niwa/state /home/niwa/niwa/secrets /home/niwa/niwa/runtime /home/niwa/niwa/backups /home/niwa/niwa/logs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
